<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pomodoro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pomodoro Timer">

    <Grid x:Name="RootGrid" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Phase indicator and session counter -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8">
            <TextBlock x:Name="PhaseText"
                       Text="Work"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="SessionText"
                       Text="Pomodoros completed: 0"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Opacity="0.7"/>
        </StackPanel>

        <!-- Countdown display with progress ring -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing x:Name="ProgressRing"
                          IsIndeterminate="False"
                          Value="0"
                          Width="280"
                          Height="280"
                          Background="Transparent"/>
            <TextBlock x:Name="TimerText"
                       Text="25:00"
                       FontSize="72"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Margin="0,16,0,16">
            <Button x:Name="StartPauseButton"
                    Content="Start"
                    Click="StartPause_Click"
                    Width="100"
                    Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="ResetButton"
                    Content="Reset"
                    Click="Reset_Click"
                    Width="100"/>
            <Button x:Name="SettingsButton"
                    Content="&#xE713;"
                    FontFamily="Segoe MDL2 Assets"
                    Click="Settings_Click"
                    Width="48"/>
        </StackPanel>

        <!-- Settings flyout panel -->
        <StackPanel x:Name="SettingsPanel"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Spacing="12"
                    Padding="16"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"/>

            <StackPanel Spacing="4">
                <TextBlock Text="Work duration (minutes)"/>
                <Slider x:Name="WorkSlider"
                        Minimum="1" Maximum="60" Value="25"
                        ValueChanged="WorkSlider_ValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Short break (minutes)"/>
                <Slider x:Name="ShortBreakSlider"
                        Minimum="1" Maximum="30" Value="5"
                        ValueChanged="ShortBreakSlider_ValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Long break (minutes)"/>
                <Slider x:Name="LongBreakSlider"
                        Minimum="1" Maximum="60" Value="15"
                        ValueChanged="LongBreakSlider_ValueChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Auto-start next phase" VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="AutoStartToggle"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
