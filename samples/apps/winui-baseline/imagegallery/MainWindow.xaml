<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImageGallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Image Gallery">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="8" Spacing="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Button x:Name="OpenFolderButton" Click="OpenFolder_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE838;" FontSize="16"/>
                    <TextBlock Text="Open Folder"/>
                </StackPanel>
            </Button>
            <AppBarSeparator/>
            <Button x:Name="SlideshowButton" Click="Slideshow_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE786;" FontSize="16"/>
                    <TextBlock Text="Slideshow"/>
                </StackPanel>
            </Button>
            <Button x:Name="StopSlideshowButton" Click="StopSlideshow_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                    <TextBlock Text="Stop"/>
                </StackPanel>
            </Button>
            <AppBarSeparator/>
            <TextBlock Text="Interval:" VerticalAlignment="Center"/>
            <NumberBox x:Name="IntervalBox" Value="3" Minimum="1" Maximum="30"
                       SpinButtonPlacementMode="Inline" SmallChange="1" Width="120"/>
        </StackPanel>

        <!-- Gallery Grid View -->
        <GridView x:Name="ImageGridView" Grid.Row="1"
                  Padding="12"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ImageGridView_ItemClick"/>

        <!-- Loading indicator -->
        <ProgressRing x:Name="LoadingRing" Grid.Row="1"
                      IsActive="False" Width="48" Height="48"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12">
            <FontIcon Glyph="&#xEB9F;" FontSize="48"
                      HorizontalAlignment="Center" Opacity="0.5"/>
            <TextBlock Text="Open a folder to browse images"
                       HorizontalAlignment="Center" Opacity="0.7"/>
        </StackPanel>

        <!-- Image Viewer Overlay -->
        <Grid x:Name="ViewerOverlay" Grid.Row="0" Grid.RowSpan="3"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Viewer toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="8" Spacing="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Button Click="BackToGallery_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <AppBarSeparator/>
                <Button x:Name="PrevButton" Click="PrevImage_Click">
                    <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                </Button>
                <Button x:Name="NextButton" Click="NextImage_Click">
                    <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                </Button>
                <AppBarSeparator/>
                <Button Click="ZoomIn_Click">
                    <FontIcon Glyph="&#xE8A3;" FontSize="16"/>
                </Button>
                <Button Click="ZoomOut_Click">
                    <FontIcon Glyph="&#xE71F;" FontSize="16"/>
                </Button>
                <Button Click="ZoomFit_Click">
                    <FontIcon Glyph="&#xE9A6;" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- Image display -->
            <ScrollViewer x:Name="ImageScrollViewer" Grid.Row="1"
                          ZoomMode="Enabled"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          MinZoomFactor="0.1" MaxZoomFactor="10"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Image x:Name="FullImage" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ScrollViewer>

            <!-- Info bar -->
            <Grid Grid.Row="2" Padding="12,8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="InfoFileName" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InfoDimensions" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InfoFileSize" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InfoDate" Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="InfoZoom" Grid.Column="1" Opacity="0.7" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="8,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
        </Border>
    </Grid>
</Window>
