<Page
    x:Class="ApiDash.Pages.PostListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ApiDash.Models"
    Loaded="Page_Loaded">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Posts" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="New Post" Click="NewPost_Click" />
        </Grid>

        <!-- Post List -->
        <ListView Grid.Row="1" x:Name="PostsListView" ItemClick="Post_Click" IsItemClickEnabled="True"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Post">
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Body}" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                VerticalAlignment="Center" Click="Delete_Click" Tag="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer: Load More / Loading / Error -->
        <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,0">
            <ProgressRing x:Name="LoadingRing" IsActive="False" />
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Spacing="4" HorizontalAlignment="Center">
                <TextBlock x:Name="ErrorText" Foreground="Red" TextAlignment="Center" />
                <Button Content="Retry" Click="Retry_Click" HorizontalAlignment="Center" />
            </StackPanel>
            <Button x:Name="LoadMoreButton" Content="Load More" Click="LoadMore_Click"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
