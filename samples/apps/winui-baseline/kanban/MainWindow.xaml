<Window
    x:Class="Kanban.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Kanban.Models"
    Title="Kanban Board">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Kanban Board" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16"/>

        <!-- Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- To Do Column -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="To Do" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <Border Background="{ThemeResource SystemFillColorNeutralBrush}" CornerRadius="10" Padding="6,2">
                                <TextBlock x:Name="TodoCountText" Text="0" FontSize="12"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+" Click="AddTodoTask_Click" ToolTipService.ToolTip="Add task"/>
                    </Grid>
                    <MenuFlyoutSeparator Grid.Row="1" Margin="0,8"/>
                    <ListView Grid.Row="2" x:Name="TodoList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskItem">
                                <Border Margin="0,4" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Tag="{x:Bind Priority}" Loaded="PriorityIndicator_Loaded"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Description, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" MaxLines="2" Margin="0,4,0,8"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                            <Button Content="&#xE104;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="EditTask_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Edit"/>
                                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="DeleteTask_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Delete"/>
                                            <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="MoveRight_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Move right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- In Progress Column -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="In Progress" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <Border Background="{ThemeResource SystemFillColorNeutralBrush}" CornerRadius="10" Padding="6,2">
                                <TextBlock x:Name="InProgressCountText" Text="0" FontSize="12"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+" Click="AddInProgressTask_Click" ToolTipService.ToolTip="Add task"/>
                    </Grid>
                    <MenuFlyoutSeparator Grid.Row="1" Margin="0,8"/>
                    <ListView Grid.Row="2" x:Name="InProgressList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskItem">
                                <Border Margin="0,4" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Tag="{x:Bind Priority}" Loaded="PriorityIndicator_Loaded"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Description, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" MaxLines="2" Margin="0,4,0,8"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                            <Button Content="&#xE104;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="EditTask_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Edit"/>
                                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="DeleteTask_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Delete"/>
                                            <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="MoveLeft_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Move left"/>
                                            <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="MoveRight_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Move right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Done Column -->
            <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Done" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <Border Background="{ThemeResource SystemFillColorNeutralBrush}" CornerRadius="10" Padding="6,2">
                                <TextBlock x:Name="DoneCountText" Text="0" FontSize="12"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+" Click="AddDoneTask_Click" ToolTipService.ToolTip="Add task"/>
                    </Grid>
                    <MenuFlyoutSeparator Grid.Row="1" Margin="0,8"/>
                    <ListView Grid.Row="2" x:Name="DoneList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskItem">
                                <Border Margin="0,4" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Tag="{x:Bind Priority}" Loaded="PriorityIndicator_Loaded"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Description, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" MaxLines="2" Margin="0,4,0,8"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                            <Button Content="&#xE104;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="EditTask_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Edit"/>
                                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="DeleteTask_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Delete"/>
                                            <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Padding="6" Click="MoveLeft_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Move left"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
