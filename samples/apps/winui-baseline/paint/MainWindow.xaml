<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Paint.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="Paint">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Padding="8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tool buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="PenButton" Content="&#xED63;" FontFamily="Segoe Fluent Icons"
                              IsChecked="True" Click="ToolButton_Click" Tag="Pen"
                              ToolTipService.ToolTip="Pen" Width="36" Height="36"/>
                <ToggleButton x:Name="EraserButton" Content="&#xE75C;" FontFamily="Segoe Fluent Icons"
                              Click="ToolButton_Click" Tag="Eraser"
                              ToolTipService.ToolTip="Eraser" Width="36" Height="36"/>
                <ToggleButton x:Name="LineButton" Content="&#xE91B;" FontFamily="Segoe Fluent Icons"
                              Click="ToolButton_Click" Tag="Line"
                              ToolTipService.ToolTip="Line" Width="36" Height="36"/>
                <ToggleButton x:Name="RectButton" Content="&#xE739;" FontFamily="Segoe Fluent Icons"
                              Click="ToolButton_Click" Tag="Rectangle"
                              ToolTipService.ToolTip="Rectangle" Width="36" Height="36"/>
                <ToggleButton x:Name="EllipseButton" Content="&#xEA3A;" FontFamily="Segoe Fluent Icons"
                              Click="ToolButton_Click" Tag="Ellipse"
                              ToolTipService.ToolTip="Ellipse" Width="36" Height="36"/>
            </StackPanel>

            <!-- Brush size -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">
                <TextBlock Text="Size:" VerticalAlignment="Center"/>
                <Slider x:Name="BrushSizeSlider" Minimum="1" Maximum="50" Value="3"
                        Width="120" VerticalAlignment="Center"/>
                <TextBlock x:Name="BrushSizeText" Text="3" VerticalAlignment="Center" Width="24"/>
            </StackPanel>

            <!-- Color picker -->
            <DropDownButton Grid.Column="2" ToolTipService.ToolTip="Pick Color">
                <Border x:Name="ColorPreview" Width="24" Height="24" CornerRadius="4"
                        Background="Black"/>
                <DropDownButton.Flyout>
                    <Flyout>
                        <ColorPicker x:Name="ColorPickerControl"
                                     Color="Black"
                                     ColorSpectrumShape="Ring"
                                     IsAlphaEnabled="False"
                                     IsMoreButtonVisible="False"
                                     ColorChanged="ColorPicker_ColorChanged"/>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- Background color -->
            <DropDownButton Grid.Column="3" ToolTipService.ToolTip="Background Color">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border x:Name="BgColorPreview" Width="24" Height="24" CornerRadius="4"
                            Background="White"/>
                    <TextBlock Text="BG" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout>
                        <ColorPicker x:Name="BgColorPickerControl"
                                     Color="White"
                                     ColorSpectrumShape="Ring"
                                     IsAlphaEnabled="False"
                                     IsMoreButtonVisible="False"
                                     ColorChanged="BgColorPicker_ColorChanged"/>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- Undo/Redo/Clear -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                <Button x:Name="UndoButton" Content="&#xE7A7;" FontFamily="Segoe Fluent Icons"
                        Click="Undo_Click" ToolTipService.ToolTip="Undo"
                        Width="36" Height="36" IsEnabled="False"/>
                <Button x:Name="RedoButton" Content="&#xE7A6;" FontFamily="Segoe Fluent Icons"
                        Click="Redo_Click" ToolTipService.ToolTip="Redo"
                        Width="36" Height="36" IsEnabled="False"/>
                <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons"
                        Click="Clear_Click" ToolTipService.ToolTip="Clear Canvas"
                        Width="36" Height="36"/>
            </StackPanel>

            <!-- Save -->
            <Button Grid.Column="6" Content="&#xE74E;" FontFamily="Segoe Fluent Icons"
                    Click="Save_Click" ToolTipService.ToolTip="Save as PNG"
                    Width="36" Height="36"/>
        </Grid>

        <!-- Drawing canvas -->
        <canvas:CanvasControl x:Name="DrawCanvas" Grid.Row="1"
                              Draw="DrawCanvas_Draw"
                              CreateResources="DrawCanvas_CreateResources"
                              PointerPressed="DrawCanvas_PointerPressed"
                              PointerMoved="DrawCanvas_PointerMoved"
                              PointerReleased="DrawCanvas_PointerReleased"
                              Background="Transparent"/>
    </Grid>
</Window>
