<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SettingsHub.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <TextBlock Text="Settings Hub" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Version 1.0.0" />
                <TextBlock Text="Build 2024.12.01" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="License" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap"
                           Text="MIT License. Copyright (c) 2024. Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files, to deal in the Software without restriction." />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Built with" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="• WinUI 3 / Windows App SDK 2.0" />
                <TextBlock Text="• .NET 10" />
                <TextBlock Text="• MVVM Pattern" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
