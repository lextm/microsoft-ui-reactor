<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SettingsHub.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="Appearance" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="ThemeSelector" SelectionChanged="ThemeSelector_SelectionChanged">
                    <RadioButton Content="Light" Tag="Light" />
                    <RadioButton Content="Dark" Tag="Dark" />
                    <RadioButton Content="System" Tag="System" />
                </RadioButtons>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Accent Color" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="AccentCombo" ItemsSource="{x:Bind ViewModel.AccentColors}"
                          SelectedItem="{x:Bind ViewModel.AccentColor, Mode=TwoWay}" Width="200" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind FormatFontSize(ViewModel.FontSize), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Slider Minimum="8" Maximum="32" StepFrequency="1"
                        Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}" Width="300" />
            </StackPanel>

            <Button Content="Reset to Defaults" Click="ResetButton_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
