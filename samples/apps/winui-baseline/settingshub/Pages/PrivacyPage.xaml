<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SettingsHub.Pages.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="Privacy" Style="{StaticResource TitleTextBlockStyle}" />

            <ToggleSwitch Header="Analytics (help improve the app)" IsOn="{x:Bind ViewModel.AnalyticsEnabled, Mode=TwoWay}" />
            <ToggleSwitch Header="Data Collection Consent" IsOn="{x:Bind ViewModel.DataCollection, Mode=TwoWay}" />

            <Button Content="Clear All Data" Click="ClearDataButton_Click" Style="{StaticResource AccentButtonStyle}" />

            <Button Content="Reset to Defaults" Click="ResetButton_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
