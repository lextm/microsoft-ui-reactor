<Project>

  <!--
    Imported automatically into any project that has a PackageReference to
    Microsoft.UI.Reactor. Establishes WinUI defaults so a consumer csproj
    can be as small as:

      <Project Sdk="Microsoft.NET.Sdk">
        <PropertyGroup>
          <OutputType>WinExe</OutputType>
          <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
        </PropertyGroup>
        <ItemGroup>
          <PackageReference Include="Microsoft.UI.Reactor" Version="..." />
        </ItemGroup>
      </Project>

    All settings are guarded so a consumer can override them by setting the
    property before the PackageReference is resolved.
  -->

  <PropertyGroup>
    <UseWinUI Condition="'$(UseWinUI)' == ''">true</UseWinUI>
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <EnableMsixTooling Condition="'$(EnableMsixTooling)' == ''">false</EnableMsixTooling>
  </PropertyGroup>

  <!--
    `dotnet build` / `dotnet run` inject Platform=AnyCPU as an MSBuild global
    property, which project-level XML cannot override. WindowsAppSDK self-
    containment requires a real architecture: it first looks at $(Platform),
    then falls back to $(RuntimeIdentifier) when Platform=AnyCPU. We therefore
    default RuntimeIdentifier (which IS settable from props) to the host arch.
    Consumers can still override by passing -p:RuntimeIdentifier=... or -p:Platform=x64.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU')">
    <RuntimeIdentifier Condition="'$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(PROCESSOR_ARCHITECTURE)' != 'ARM64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Pre-populate RuntimeIdentifiers so `restore` produces assets-file targets for
    every supported arch. Without this, restore only sees the active RID and a
    later `build -p:Platform=ARM64` would fail with NETSDK1047.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
